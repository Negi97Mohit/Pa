# =============================================================================
# AI CO-STAR OVERLAY - ENVIRONMENT TEMPLATE (.env.example)
# =============================================================================
# Copy this file to .env and add your actual API keys.
# =============================================================================

# OpenRouter (AI Model Provider)
OPENROUTER_API_KEY=your_new_openrouter_key_here
OPENROUTER_OLD_API_KEY=your_old_openrouter_key_here

# ElevenLabs (Text-to-Speech Provider)
ELEVENLABS_API_KEY=your_new_elevenlabs_key_here
ELEVENLABS_OLD_API_KEY=your_old_elevenlabs_key_here

# Noiz (Alternative Text-to-Speech Provider)
NOIZ_API_KEY=your_new_noiz_key_here
NOIZ_OLD_API_KEY=your_old_noiz_key_here

# Deepgram (Real-Time Live Speech-to-Text)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Local Server Port
PORT=3000

